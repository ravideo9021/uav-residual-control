<mxfile host="app.diagrams.net" type="device"><diagram id="D-09" name="D-09 Neural-network training and inference workflow"><mxGraphModel dx="1100" dy="575" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="615" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="LT" value="&lt;b&gt;Training workflow (offline; CLI: resland generate / train / calibrate)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#e7f0fb;strokeColor=#1f4e8c;fontColor=#0d2240;fontSize=13;fontFamily=Arial;rounded=1;arcSize=3;dashed=1;verticalAlign=top;align=left;spacingLeft=8;container=0;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1080" height="335" as="geometry"/></mxCell><mxCell id="LI" value="&lt;b&gt;Inference workflow (every step, 100 Hz loop, NumPy)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#b26b00;fontColor=#3d2600;fontSize=13;fontFamily=Arial;rounded=1;arcSize=3;dashed=1;verticalAlign=top;align=left;spacingLeft=8;container=0;" vertex="1" parent="1"><mxGeometry x="10" y="360" width="1080" height="205" as="geometry"/></mxCell><mxCell id="T1" value="&lt;b&gt;1. Generate data&lt;/b&gt;&lt;br&gt;400 PID trajectories&lt;br&gt;v_p ~ U(0, 4.0) m/s, seed 42&lt;br&gt;per-trial randomisation" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e8c;fontColor=#0d2240;fontSize=13;fontFamily=Arial;rounded=0;" vertex="1" parent="1"><mxGeometry x="30" y="45" width="230" height="95" as="geometry"/></mxCell><mxCell id="T2" value="&lt;b&gt;2. Build windows&lt;/b&gt;&lt;br&gt;H_t (W = 4) → X [N, 24]&lt;br&gt;targets Y = (τ_DAGE, a_GE)" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e8c;fontColor=#0d2240;fontSize=13;fontFamily=Arial;rounded=0;" vertex="1" parent="1"><mxGeometry x="290" y="45" width="230" height="95" as="geometry"/></mxCell><mxCell id="T3" value="&lt;b&gt;3. Split by trajectory&lt;/b&gt;&lt;br&gt;340 train / 60 held-out&lt;br&gt;sub-sample 200,000 windows" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e8c;fontColor=#0d2240;fontSize=13;fontFamily=Arial;rounded=0;" vertex="1" parent="1"><mxGeometry x="550" y="45" width="230" height="95" as="geometry"/></mxCell><mxCell id="T4" value="&lt;b&gt;4. Standardise&lt;/b&gt;&lt;br&gt;fit μ, s on training set&lt;br&gt;(inputs and targets)" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e8c;fontColor=#0d2240;fontSize=13;fontFamily=Arial;rounded=0;" vertex="1" parent="1"><mxGeometry x="810" y="45" width="260" height="95" as="geometry"/></mxCell><mxCell id="T5" value="&lt;b&gt;5. Train MLP 24-64-64-32-2, tanh&lt;/b&gt;&lt;br&gt;MSE + 1e-5·‖θ‖²&lt;br&gt;Adam 8e-4 × 0.94^epoch, batch 256&lt;br&gt;dropout 0.05, input noise 0.02&lt;br&gt;grad-norm clip 5.0, init seed 1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e8c;fontColor=#0d2240;fontSize=13;fontFamily=Arial;rounded=0;" vertex="1" parent="1"><mxGeometry x="790" y="180" width="280" height="140" as="geometry"/></mxCell><mxCell id="DX" value="val. MSE improved&lt;br&gt;in last 6 epochs?" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e8c;fontColor=#0d2240;fontSize=12;fontFamily=Arial;rhombus;" vertex="1" parent="1"><mxGeometry x="590" y="205" width="160" height="90" as="geometry"/></mxCell><mxCell id="T7" value="&lt;b&gt;6. Restore&lt;/b&gt;&lt;br&gt;best epoch" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e8c;fontColor=#0d2240;fontSize=13;fontFamily=Arial;rounded=0;" vertex="1" parent="1"><mxGeometry x="395" y="220" width="165" height="60" as="geometry"/></mxCell><mxCell id="T8" value="&lt;b&gt;7. Calibrate gate&lt;/b&gt;&lt;br&gt;d0 = 99th percentile&lt;br&gt;of d on held-out" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e8c;fontColor=#0d2240;fontSize=13;fontFamily=Arial;rounded=0;" vertex="1" parent="1"><mxGeometry x="200" y="215" width="170" height="70" as="geometry"/></mxCell><mxCell id="T9" value="&lt;b&gt;Model artefact&lt;/b&gt;&lt;br&gt;weights.pt / .npz&lt;br&gt;norm_stats.json&lt;br&gt;gate_calibration.json&lt;br&gt;training_log.csv&lt;br&gt;model_card.md, SHA-256" style="whiteSpace=wrap;html=1;fillColor=#eef6ee;strokeColor=#3a7d44;fontColor=#173b1d;fontSize=12;fontFamily=Arial;shape=cylinder3;boundedLbl=1;size=9;" vertex="1" parent="1"><mxGeometry x="20" y="185" width="165" height="145" as="geometry"/></mxCell><mxCell id="I1" value="&lt;b&gt;Step k inputs&lt;/b&gt;&lt;br&gt;obs_k, u_nom,k" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e8c;fontColor=#0d2240;fontSize=13;fontFamily=Arial;rounded=0;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="150" height="60" as="geometry"/></mxCell><mxCell id="I2" value="&lt;b&gt;HistoryBuffer&lt;/b&gt;&lt;br&gt;H_t [B, 24]" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e8c;fontColor=#0d2240;fontSize=13;fontFamily=Arial;rounded=0;" vertex="1" parent="1"><mxGeometry x="215" y="420" width="170" height="60" as="geometry"/></mxCell><mxCell id="I3" value="&lt;b&gt;Standardise&lt;/b&gt;&lt;br&gt;(μ, s)" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e8c;fontColor=#0d2240;fontSize=13;fontFamily=Arial;rounded=0;" vertex="1" parent="1"><mxGeometry x="425" y="405" width="150" height="50" as="geometry"/></mxCell><mxCell id="I4" value="&lt;b&gt;MLP forward&lt;/b&gt;&lt;br&gt;(NumPy)" style="whiteSpace=wrap;html=1;fillColor=#e7f0fb;strokeColor=#1f4e8c;fontColor=#0d2240;fontSize=13;fontFamily=Arial;rounded=0;" vertex="1" parent="1"><mxGeometry x="610" y="405" width="150" height="50" as="geometry"/></mxCell><mxCell id="I5" value="&lt;b&gt;De-standardise&lt;/b&gt;&lt;br&gt;→ tau_hat, a_hat" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e8c;fontColor=#0d2240;fontSize=13;fontFamily=Arial;rounded=0;" vertex="1" parent="1"><mxGeometry x="795" y="405" width="150" height="50" as="geometry"/></mxCell><mxCell id="I6" value="Gate (M5): d(H_t) = max_i |H_t,i − μ_i| / s_i  →  σ = clip(exp(−max(0, d − d0)/κ), 0, 1)" style="whiteSpace=wrap;html=1;fillColor=#eef6ee;strokeColor=#3a7d44;fontColor=#173b1d;fontSize=12;fontFamily=Arial;rounded=0;" vertex="1" parent="1"><mxGeometry x="425" y="490" width="520" height="50" as="geometry"/></mxCell><mxCell id="I7" value="&lt;b&gt;Apply&lt;/b&gt;&lt;br&gt;u = u_nom&lt;br&gt;− σ·r̂" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e8c;fontColor=#0d2240;fontSize=13;fontFamily=Arial;rounded=0;" vertex="1" parent="1"><mxGeometry x="975" y="430" width="105" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=none;html=1;rounded=0;fontSize=11;fontFamily=Arial;fontStyle=2;strokeColor=#3b4a60;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=open;endFill=0;" edge="1" parent="1" source="T1" target="T2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=none;html=1;rounded=0;fontSize=11;fontFamily=Arial;fontStyle=2;strokeColor=#3b4a60;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=open;endFill=0;" edge="1" parent="1" source="T2" target="T3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=none;html=1;rounded=0;fontSize=11;fontFamily=Arial;fontStyle=2;strokeColor=#3b4a60;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=open;endFill=0;" edge="1" parent="1" source="T3" target="T4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=none;html=1;rounded=0;fontSize=11;fontFamily=Arial;fontStyle=2;strokeColor=#3b4a60;endSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.536;entryY=0;entryDx=0;entryDy=0;endArrow=open;endFill=0;" edge="1" parent="1" source="T4" target="T5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" st