<mxfile host="app.diagrams.net" type="device"><diagram id="D-07a" name="D-07a Class diagram - configuration"><mxGraphModel dx="1100" dy="480" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ExperimentConfig" value="&lt;p style=&quot;margin:4px 0;text-align:center&quot;&gt;&lt;b&gt;ExperimentConfig&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left&quot;&gt;schema_version: str&lt;br&gt;sim: SimConfig&lt;br&gt;noise: NoiseConfig&lt;br&gt;profiles: dict[str, DisturbanceProfile]&lt;br&gt;controllers: ControllerConfig&lt;br&gt;residual: ResidualConfig&lt;br&gt;gate: GateConfig&lt;br&gt;plan: PlanConfig&lt;br&gt;thresholds: EnvelopeThresholds&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left&quot;&gt;validate() list[ValidationIssue]&lt;br&gt;load_config(path) {static}&lt;br&gt;load_preset(name) {static}&lt;/div&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e8c;fontColor=#0d2240;fontSize=13;fontFamily=Arial;verticalAlign=top;align=left;overflow=fill;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="20" width="330" height="222" as="geometry"/></mxCell><mxCell id="SimConfig" value="&lt;p style=&quot;margin:4px 0;text-align:center&quot;&gt;&lt;b&gt;SimConfig&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left&quot;&gt;dt: float = 0.01&lt;br&gt;T: float = 12.0&lt;br&gt;z0: float = 4.0&lt;br&gt;v_des: float = 0.42&lt;br&gt;m: float = 1.5&lt;br&gt;J_x: float = 0.020&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e8c;fontColor=#0d2240;fontSize=13;fontFamily=Arial;verticalAlign=top;align=left;overflow=fill;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry