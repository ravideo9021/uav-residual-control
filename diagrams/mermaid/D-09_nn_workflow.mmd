  T4["4. Standardise<br/>fit μ, s on training set<br/>(inputs and targets)"]
  T5["5. Train MLP 24-64-64-32-2, tanh<br/>MSE + 1e-5·‖θ‖²<br/>Adam 8e-4 × 0.94^epoch, batch 256<br/>dropout 0.05, input noise 0.02<br/>grad-norm clip 5.0, init seed 1"]
  DX{"val. MSE improved<br/>in last 6 epochs?"}
  T7["6. Restore<br/>best epoch"]
  T8["7. Calibrate gate<br/>d0 = 99th percentile<br/>of d on held-out"]
  T9[("Model artefact<br/>weights.pt / .npz<br/>norm_stats.json<br/>gate_calibration.json<br/>training_log.csv<br/>model_card.md, SHA-256")]
