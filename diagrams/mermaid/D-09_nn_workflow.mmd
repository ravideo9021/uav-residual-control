flowchart LR
  T1["1. Generate data<br/>400 PID trajectories<br/>v_p ~ U(0, 4.0) m/s, seed 42<br/>per-trial randomisation"]
  T2["2. Build windows<br/>H_t (W = 4) → X [N, 24]<br/>targets Y = (τ_DAGE, a_GE)"]
